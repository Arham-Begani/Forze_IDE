# Forze IDE — desktop build-time environment.
# Copy to `.env` (gitignored) and fill in. Only VITE_-prefixed vars reach the app.

# Built-in Gemini key for the general model. When set, Forze chat works the
# moment the app opens — users don't need to bring a key. Get one at
# https://aistudio.google.com/app/apikey
#
# NOTE: anything bundled into a client build is extractable by a determined
# user. Use a key scoped/quota-limited to this purpose, and for production
# consider proxying through a server-side broker instead (aiConfig.ts is the
# single place to swap the resolution strategy).
VITE_FORZE_GEMINI_KEY=

# Built-in Vercel access token for the Deployments page. When set, Deployments
# connects the moment the app opens — no pasting into Settings. A token entered
# in Settings → Integrations overrides this one. Create at:
# https://vercel.com/account/tokens
#
# NOTE: same caveat as the Gemini key — anything in a client build is
# extractable, so scope the token and rotate it if it leaks.
VITE_FORZE_VERCEL_TOKEN=
# Optional Vercel team id. Leave blank for default/personal scope.
VITE_FORZE_VERCEL_TEAM_ID=

# Optional: base URL for the social publishing broker (apps/web).
# VITE_FORGE_APP_URL=https://your-forze-web.example.com

# Forze account — auth + cloud persistence (gates the whole app).
# Use the SAME Supabase project as the Forze web app: copy these from the web
# repo's `.env.local` keys NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY. The anon key is meant to ship in the binary —
# Row Level Security (auth.uid() = user_id) is the security boundary, not key
# secrecy. The session itself is stored in the OS keychain, never localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
